# Copy this file to a new file named exactly:  .env
# (Never commit .env. It holds your secret key. .gitignore already protects it.)
# No quotes, and no spaces around the "=".

PROFILE=openai
OPENAI_API_KEY=paste-your-own-key-here

# Cheap model for testing; the instructor will tell you if a run should use a stronger one.
MODEL=gpt-6-luna

# Spending guard: the router stops after any step once a run reaches either limit.
# MAX_COST_USD=2.00
# MAX_RUN_TOKENS=1000000

# Other optional overrides
# MAX_STEPS=12              most agent runs in one workflow
# INPUT_TOKEN_BUDGET=60000  most tokens in one request
# REPLY_TOKENS=16000        longest reply an agent may write

# Advanced: other OpenAI-style services (free Groq tier, local Ollama) are available through
# PROFILE=groq / ollama / custom. See providers.py. Not needed for the course.
